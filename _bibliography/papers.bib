  AUTHOR = {Jean-Labadye*†‡, Lucie and Dubus*†, Gabriel and Cazau†, Dorian and Farrugia‡, Nicolas and Marmoret‡, Axel and Adam*, Olivier},
  BOOKTITLE = {{GRETSI'25 - XXXe Colloque Francophone de Traitement du Signal et des Images}},
